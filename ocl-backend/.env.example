# MacBook M serisi
DEVICE=mps
# DEVICE=cpu

# SAM model tipi: vit_b (hızlı) | vit_l | vit_h (yavaş ama iyi)
SAM_MODEL_TYPE=vit_b
SAM_CHECKPOINT=weights/sam_vit_b_01ec64.pth
# SAM_DEVICE=cpu

# Birincil gömü: DINOv2 (torch.hub)
DINOV2_MODEL=dinov2_vitb14
DINOV2_IMG_SIZE=224

# Yedek (DINOv2 yüklenemezse)
VLM_MODEL_NAME=openai/clip-vit-base-patch32

# Model önbelleği (proje içi — önerilir)
TORCH_HOME=cache/torch
HF_HOME=cache/huggingface

BUFFER_SIZE=5000
CORS_ORIGINS=http://localhost:5173/

# Tespit
# DETECTION_THRESHOLD=0.65
# DETECTION_TOP_K=30

# Kalıcı hafıza
# ONLINE_MEMORY_ENABLED=1
# ONLINE_MEMORY_PATH=data/online_memory.pkl
